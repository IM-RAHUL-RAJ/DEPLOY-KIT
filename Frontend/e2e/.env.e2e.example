# Playwright journeys read these from the environment. Copy to a local, untracked
# file and export them before `npx playwright test` (values below match the seed).
E2E_BASE_URL=http://localhost:4200
E2E_TRADE_API=http://localhost:8081
E2E_AUTH_API=http://localhost:3000
E2E_USERNAME=demo
E2E_PASSWORD=replace-with-the-seeded-demo-password
E2E_ACCOUNT_ID=1
E2E_SYMBOL=AAPL
# Only the admin and onboarding journeys need these.
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=replace-with-the-seeded-admin-password
