{
  "name": "trading-app-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "config": "node scripts/sync-config.mjs --print",
    "start": "node scripts/start.mjs",
    "prebuild": "node scripts/sync-config.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/extract-error-codes.mjs",
    "test": "ng test --watch=false --no-progress --browsers=ChromeHeadless",
    "pretest:coverage": "node scripts/sync-config.mjs",
    "test:coverage": "ng test --watch=false --no-progress --browsers=ChromeHeadless --code-coverage",
    "coverage:report": "node scripts/coverage-report.mjs",
    "test:integration": "ng test --watch=false --no-progress --browsers=ChromeHeadless --include=src/app/integration/**/*.spec.ts",
    "generate:trade-api": "npm run contracts:sync && openapi-generator-cli generate --generator-key trade-api",
    "generate:auth-api": "npm run contracts:sync && openapi-generator-cli generate --generator-key auth-api",
    "generate": "npm run contracts:sync && openapi-generator-cli generate",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report playwright-report",
    "bundle:scan": "node scripts/scan-bundle.mjs",
    "contracts:sync": "node scripts/sync-contracts.mjs && node scripts/extract-error-codes.mjs",
    "contracts:codes": "node scripts/extract-error-codes.mjs"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "chart.js": "^4.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@openapitools/openapi-generator-cli": "2.13.4",
    "@playwright/test": "^1.48.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
