# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT SETTINGS (EC2 + docker compose)  -  the only block you normally edit
# ═══════════════════════════════════════════════════════════════════════════════
#   cp .env.example .env     then set PUBLIC_HOST and the SECRETS marked below.
#   docker compose up -d --build
#
# Address the BROWSER uses to reach this box: the EC2 public IPv4 or DNS name.
PUBLIC_HOST=localhost
# http now; https once a certificate (ALB/CloudFront) is in front.
PUBLIC_SCHEME=http

# Per-URL overrides (optional; default = PUBLIC_SCHEME://PUBLIC_HOST:<port>):
#FRONTEND_PUBLIC_URL=
#AUTH_PUBLIC_URL=
#ORDER_PUBLIC_URL=

# Database: "localdb" starts the bundled Postgres container (schema.sql + seed run
# automatically on first start). For RDS: leave COMPOSE_PROFILES empty, set DB_HOST to
# the RDS endpoint, then load the SQL (guide step 4.3)
COMPOSE_PROFILES=localdb
# RDS (PostgreSQL 15+) forces TLS. Then set:  JDBC_EXTRA=&sslmode=require  and  PGSSLMODE=no-verify
# (Node's pg driver reads PGSSLMODE). Leave both empty for the bundled Postgres.
JDBC_EXTRA=
PGSSLMODE=

# Optional ETL (Postgres -> DuckDB analytics; nothing else reads it): COMPOSE_PROFILES=localdb,etl

# Frontend build (change only if your frontend differs; see Frontend/Dockerfile):
#   AUTH_SERVICE_URL / ORDER_SERVICE_URL are swapped in when the container STARTS.

# ═══════════════════════════════════════════════════════════════════════════════
# ETP TRADING PLATFORM — environment variables
# ═══════════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env      then put your own keys and passwords in .env
#
# .env and this file list exactly the same variables; scripts/check-deploy.mjs fails
# if they ever drift apart. Every service reads Application/.env:
#   auth-service (NestJS)         Services/auth-service      AUTH_SERVICE_PORT
#   order-service (Spring Boot)   Services/order-service     ORDER_SERVICE_PORT
#   executor-service (Spring)     Services/executor-service  EXECUTOR_SERVICE_PORT
#   ETL Layer (Python)            ETL Layer
#   Frontend (Angular)            Frontend                   FRONTEND_PORT (API URLs only;
#                                 nothing secret ever reaches the browser)
#   docker compose                docker-compose.yml
#
# Where a variable is not set, the service takes the value from the shared
# Config/application.yml. Precedence: real environment > .env > Config.
# Only the secrets below must differ from this template.
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE ADDRESSES AND PORTS (Config: frontend, services.*)
# ─────────────────────────────────────────────────────────────────────────────
# The *_URL values are what a browser uses to reach each service; the frontend
# bundle is built with AUTH_SERVICE_URL and ORDER_SERVICE_URL.
# FRONTEND_URL / AUTH_SERVICE_URL / ORDER_SERVICE_URL / EXECUTOR_SERVICE_URL are DERIVED by docker-compose
# from PUBLIC_SCHEME + PUBLIC_HOST above. Set FRONTEND_PUBLIC_URL etc. only to override one.
#FRONTEND_URL=http://localhost:4200
FRONTEND_PORT=4200
#AUTH_SERVICE_URL=http://localhost:3000
AUTH_SERVICE_PORT=3000
#ORDER_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_PORT=8081
#EXECUTOR_SERVICE_URL=http://localhost:8082
EXECUTOR_SERVICE_PORT=8082

# Browser origins allowed to call the auth service and the order service with
# credentials (comma-separated): the frontend's address.
#CORS_ALLOWED_ORIGINS=   (derived: the frontend public URL; set to add more origins, comma-separated)

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE: PostgreSQL (Config: database)
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=trading_system_db
DB_USER=postgres
# SECRET: the postgres user's password. No service has a default.
DB_PASSWORD=replace-with-your-postgres-password
PG_SCHEMA=trading
# docker compose publishes its Postgres on this host port.
POSTGRES_HOST_PORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# KAFKA (Config: kafka)
# ─────────────────────────────────────────────────────────────────────────────
# From the host machine. Inside docker compose every container uses kafka:29092
# (set in docker-compose.yml), as Config/application.yml says.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# The address other machines reach the bundled broker on (docker compose).
#KAFKA_ADVERTISED_HOST=   (derived from PUBLIC_HOST)
# How long a publish waits for an unreachable broker before giving up (ms).
KAFKA_MAX_BLOCK_MS=3000
ORDERS_TOPIC=orders
TRADE_EVENTS_TOPIC=trade-events
MARKET_DATA_TOPIC=market-data

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY: JWT, cookies, sign-in (Config: auth)
# ─────────────────────────────────────────────────────────────────────────────
# SECRET: the shared HS256 signing key. The auth service signs with it and the
# order service verifies with it. At least 32 bytes, or both refuse to start:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=auth-service
JWT_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# Refresh token cookie (HttpOnly + SameSite). Browsers honour Secure on
# http://localhost, so true works locally.
COOKIE_NAME=refresh_token
# true needs https. Over plain http://<ec2-ip> the browser drops a Secure cookie -> set false until you have https (CloudFront/ALB+ACM).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Login throttling (brute-force protection) and email verification codes.
THROTTLE_MAX_ATTEMPTS=5
THROTTLE_WINDOW_MS=900000
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────────────────────
# MARKET DATA: Fauxnance (Config: market-data). The executor's poller only.
# ─────────────────────────────────────────────────────────────────────────────
# SECRET: your Fauxnance API key (X-Api-Key), 2000 requests a day. The executor
# refuses to start without it. Never sent to the browser.
FAUXNANCE_API_KEY=replace-with-your-fauxnance-api-key
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
# How often the poller refreshes every symbol somebody depends on, in batches of 25.
POLL_INTERVAL_SECONDS=60
# How long the order service waits for the poller to fetch a symbol nobody had
# asked about yet (ms), how long a viewed symbol stays tracked, and how old the
# feed may be before /health reports it degraded.
MARKET_AWAIT_MS=6000
MARKET_VIEW_INTEREST_MINUTES=30
MARKET_HEALTH_FRESH_MINUTES=120

# ─────────────────────────────────────────────────────────────────────────────
# AUTOMATED TRADING (Config: strategy)
# ─────────────────────────────────────────────────────────────────────────────
# How often active price targets are checked against the latest stored quote.
STRATEGY_SWEEP_INTERVAL_MS=15000
# How long an automated order may take to be accepted by the order API.
STRATEGY_ORDER_TIMEOUT_MS=30000
# The order API automated orders are placed through: the order service itself.
STRATEGY_TRADE_API_URL=http://localhost:8081

# ─────────────────────────────────────────────────────────────────────────────
# NOTIFICATIONS (Config: notifications)
# ─────────────────────────────────────────────────────────────────────────────
# How often orders that settled without their Kafka trade event are notified anyway.
NOTIFICATION_SWEEP_INTERVAL_MS=20000

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL: SMTP (Config: email). Registration codes, password resets, notifications.
# ─────────────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to run without mail: verification codes are written to the
# auth-service log instead, and email notifications are recorded as FAILED.
# Port 465 is implicit TLS, anything else STARTTLS. For Gmail use an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-your-smtp-username
# SECRET
SMTP_PASS=replace-with-your-smtp-app-password
SMTP_FROM="Akatsuki <no-reply@example.com>"

# ─────────────────────────────────────────────────────────────────────────────
# TRADING ASSISTANT: Groq LLM (Config: llm)
# ─────────────────────────────────────────────────────────────────────────────
# SECRET: from https://console.groq.com. Empty disables the assistant's answers.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=10

# ─────────────────────────────────────────────────────────────────────────────
# ETL LAYER: PostgreSQL → DuckDB analytics (Config: etl)
# ─────────────────────────────────────────────────────────────────────────────
# A relative path is relative to the ETL Layer folder.
DUCKDB_PATH=../Databases/DuckDB/analytics/analytics.duckdb
ETL_REFRESH_INTERVAL_SECONDS=45
